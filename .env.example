# Supabase Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY

# Render sets PORT automatically, keep this for local testing only
PORT=3000

# Optional: protects admin/test routes. Use any long random text.
ADMIN_SECRET=change-me-later

# How many days the backend should keep generating prayer notification events.
SCHEDULE_AHEAD_DAYS=35
